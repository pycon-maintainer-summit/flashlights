# The PyCon US Maintainer Summit's production instance. Copy to .env on the host, or set
# each variable on the platform. The core's environment reference lists
# every variable: https://docs.flashlights.app/0.2.0/developer/environment/
#
# The boot fails at once, naming every missing variable, when one of the
# required ones is unset.

# Required
SECRET_KEY=                       # python -c "import secrets; print(secrets.token_urlsafe(50))"
FERNET_KEY=                       # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_ALLOWED_HOSTS=.herokuapp.com,summit.flashlights.app
DATABASE_URL=                     # from the platform's Postgres add-on
REDIS_URL=                        # from the platform's Redis add-on (or CELERY_BROKER_URL)
EMAIL_URL=                        # smtp://user:password@smtp.mailgun.org:587/?tls=true
DJANGO_DEFAULT_FROM_EMAIL=Maintainer Summit <noreply@mail.flashlights.app>
USE_OBJECT_STORAGE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=              # https://<account>.r2.cloudflarestorage.com, say

# Identity (the same values as presets/summit/env, plus the images the
# app ships, served by the instance itself; an image not set here is
# generated by the core from the title and the colour)
SITE_TITLE=PyCon US Maintainer Summit
SITE_SHORT_NAME=Maintainer Summit
SITE_DESCRIPTION=A gathering for open source Python maintainers at PyCon US
BRAND_PRIMARY=#a16207
SITE_LOGO=https://summit.flashlights.app/static/flashlights_summit/logo.svg
SITE_FAVICON=https://summit.flashlights.app/static/flashlights_summit/favicon.svg
# DOCS_URL stays unset until the summit's docs have a Flashlights page that
# links to the core docs at the pinned version; until then the help links
# follow the image (and the landing's team descriptions link and the
# volunteer resources card, which need a community docs site, stay off).
# DOCS_URL=https://pycon-maintainer-summit.github.io/docs/flashlights/

# Switches
SPONSORSHIP_ENABLED=false
VOLUNTEERING_ENABLED=true
STATS_PUBLIC=true

# The app
EXTRA_APPS=flashlights_summit
